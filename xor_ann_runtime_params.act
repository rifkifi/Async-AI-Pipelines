/* ================================================================
  xor_ann_runtime_params.act

  XOR network using nn_layers.act.

  Architecture:
    x0, x1 -> FCLayerActParam<2,2,step> -> hidden[2]
           -> FCLayerActParam<2,2,step> -> xor_out, xnor_out

  The weights and biases are not template parameters of the layers. They are
  sent through parameter channels by separate parameter-source processes.
 ================================================================ */

import "nn_layers.act";


/* ---------------------------------------------------------------
  XOR_ANN_RuntimeParams
---------------------------------------------------------------- */

defproc XOR_ANN_RuntimeParams (chan?(math::fixpoint<8,8>) x0_in, x1_in;
                               chan!(math::fixpoint<8,8>) xor_out, xnor_out)
{
  chan(math::fixpoint<8,8>) input_vec[2];
  chan(math::fixpoint<8,8>) hidden_out[2];
  chan(math::fixpoint<8,8>) class_out[2];

  chan(math::fixpoint<8,8>) hidden_w[4];
  chan(math::fixpoint<8,8>) hidden_b[2];
  chan(math::fixpoint<8,8>) output_w[4];
  chan(math::fixpoint<8,8>) output_b[2];

  input_vec[0] = x0_in;
  input_vec[1] = x1_in;
  class_out[0] = xor_out;
  class_out[1] = xnor_out;

  // Hidden layer parameters:
  //   h0 = step(5*x0 + 5*x1 - 3)
  //   h1 = step(5*x0 + 5*x1 - 8)
  FCLayerParamSource<2, 2,
                     { 5.0, 5.0,
                       5.0, 5.0 },
                     { -3.0, -8.0 }> hidden_params (hidden_w, hidden_b);

  FCLayerActParam<2, 2, 1, 0.0> hidden_layer (
    input_vec, hidden_w, hidden_b, hidden_out
  );

  // Output layer parameters:
  //   xor_out  = step( 5*h0 - 5*h1 - 2)
  //   xnor_out = step(-5*h0 + 5*h1 + 2)
  FCLayerParamSource<2, 2,
                     {  5.0, -5.0,
                       -5.0,  5.0 },
                     { -2.0, 2.0 }> output_params (output_w, output_b);

  FCLayerActParam<2, 2, 1, 0.0> output_layer (
    hidden_out, output_w, output_b, class_out
  );
}


/* ---------------------------------------------------------------
  XorRuntimeParamTestbench
---------------------------------------------------------------- */

defproc XorRuntimeParamTestbench (chan!(math::fixpoint<8,8>) x0, x1;
                                  chan?(math::fixpoint<8,8>) xor_out, xnor_out)
{
  math::fixpoint<8,8> zero, one, half, xv, nv, diff;
  bool xb, nb;

  chp {
    zero.set(zero.const(0.0));
    one.set(one.const(1.0));
    half.set(half.const(0.5));

    x0!zero; x1!zero;
    xor_out?xv; xnor_out?nv;
    diff := xv - half;
    [ ~diff.negative() -> xb := true [] else -> xb := false ];
    diff := nv - half;
    [ ~diff.negative() -> nb := true [] else -> nb := false ];
    log("xor(0,0) = ", xb);
    log("xnor(0,0) = ", nb);

    x0!zero; x1!one;
    xor_out?xv; xnor_out?nv;
    diff := xv - half;
    [ ~diff.negative() -> xb := true [] else -> xb := false ];
    diff := nv - half;
    [ ~diff.negative() -> nb := true [] else -> nb := false ];
    log("xor(0,1) = ", xb);
    log("xnor(0,1) = ", nb);

    x0!one; x1!zero;
    xor_out?xv; xnor_out?nv;
    diff := xv - half;
    [ ~diff.negative() -> xb := true [] else -> xb := false ];
    diff := nv - half;
    [ ~diff.negative() -> nb := true [] else -> nb := false ];
    log("xor(1,0) = ", xb);
    log("xnor(1,0) = ", nb);

    x0!one; x1!one;
    xor_out?xv; xnor_out?nv;
    diff := xv - half;
    [ ~diff.negative() -> xb := true [] else -> xb := false ];
    diff := nv - half;
    [ ~diff.negative() -> nb := true [] else -> nb := false ];
    log("xor(1,1) = ", xb);
    log("xnor(1,1) = ", nb)
  }
}


defproc test ()
{
  chan(math::fixpoint<8,8>) x0, x1;
  chan(math::fixpoint<8,8>) xor_out, xnor_out;

  XOR_ANN_RuntimeParams ann (x0, x1, xor_out, xnor_out);
  XorRuntimeParamTestbench tb (x0, x1, xor_out, xnor_out);
}
