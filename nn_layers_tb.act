/* ================================================================
  nn_layers_tb.act

  Functional testbench for nn_layers.act.

  Each test instantiates a Source, the DUT, and a Sink/Checker.
  Sources send fixed-point tokens; Checkers compare results to a
  golden reference and emit a bool pass/fail on a channel.
  Main collects all results and prints them with log().

  ================================================================ */

import "math/fxp.act";
import "nn_layers.act";


/* ================================================================
  1.  Activation - all four modes
  ================================================================ */

/* ActSrc<N, V[]>: sends N fixed-point values from a preal array */
template<pint N; preal V[N]>
defproc ActSrc (chan!(math::fixpoint<8,8>) out)
{
  math::fixpoint<8,8> v[N];
  chp {
    (;i: N: v[i].set(v[i].const(V[i])));
    (;i: N: out!v[i])
  }
}

/* ActSink<N, EXP[]>: receives N values, checks each against EXP[i] */
template<pint N; preal EXP[N]>
defproc ActSink (chan?(math::fixpoint<8,8>) in; chan!(bool) pass)
{
  math::fixpoint<8,8> v, exp[N], eps, negone, diff, adiff;
  bool ok;
  chp {
    eps.set(eps.const(0.02));
    negone.set(negone.const(-1.0));
    (;i: N: exp[i].set(exp[i].const(EXP[i])));
    ok := true;
    (;i: N:
      in?v;
      diff := v - exp[i];
      [ ~diff.negative() -> adiff := diff
      [] else             -> adiff := negone * diff ];
      diff := eps - adiff;
      [ diff.negative() -> ok := false [] else -> skip ]
    );
    pass!ok
  }
}

/* 1a. Linear (ACT_FN=0): output == input */
defproc TB_Act_Linear (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) c0, c1;
  ActSrc<4, {-1.0, 0.0, 0.5, 2.0}>  src (.out = c0);
  Activation<0, 0.0>                 dut (.in  = c0, .out = c1);
  ActSink<4, {-1.0, 0.0, 0.5, 2.0}> snk (.in  = c1, .pass = pass);
}

/* 1b. Step (ACT_FN=1): >= 0 -> 1.0, else 0.0 */
defproc TB_Act_Step (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) c0, c1;
  ActSrc<4, {-1.0, 0.0, 0.5, 2.0}>  src (.out = c0);
  Activation<1, 0.0>                 dut (.in  = c0, .out = c1);
  ActSink<4, { 0.0, 1.0, 1.0, 1.0}> snk (.in  = c1, .pass = pass);
}

/* 1c. ReLU (ACT_FN=2): max(0, x) */
defproc TB_Act_ReLU (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) c0, c1;
  ActSrc<4, {-2.0, -0.5, 0.0, 1.5}>  src (.out = c0);
  Activation<2, 0.0>                  dut (.in  = c0, .out = c1);
  ActSink<4, { 0.0,  0.0, 0.0, 1.5}> snk (.in  = c1, .pass = pass);
}

/* 1d. Leaky ReLU (ACT_FN=3, LEAK=0.1): x>=0 -> x, else 0.1*x */
defproc TB_Act_LeakyReLU (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) c0, c1;
  ActSrc<4, {-2.0,  -1.0, 0.0, 1.0}>  src (.out = c0);
  Activation<3, 0.1>                   dut (.in  = c0, .out = c1);
  ActSink<4, {-0.2, -0.1, 0.0, 1.0}>  snk (.in  = c1, .pass = pass);
}


/* ================================================================
  2.  WindowAssembler - 4x4 image, 3x3 kernel

  Pixels 0..15 sent in row-major order.
  First valid window top-left at (0,0), assembled when circular buffer
  holds rows 0-2 and col index reaches 2:
    pixels (r,c) in a width-4 image: (0,0)..(2,2)
    = 0,1,2, 4,5,6, 8,9,10
  A 4x4 image with K=3 produces (4-3+1)^2 = 4 valid windows total.
  We check the first and drain the rest.
  ================================================================ */

template<pint DUMMY>
defproc WinAsmSrc (chan!(math::fixpoint<8,8>) pix_in)
{
  math::fixpoint<8,8> v[16];
  chp {
    (;i: 16: v[i].set(v[i].const(i * 1.0)));
    (;i: 16: pix_in!v[i])
  }
}

template<pint DUMMY>
defproc WinAsmSink (chan?(math::fixpoint<8,8>) win[9]; chan!(bool) pass)
{
  math::fixpoint<8,8> v, exp[9], eps, negone, diff, adiff;
  bool ok;
  chp {
    eps.set(eps.const(0.02));
    negone.set(negone.const(-1.0));
    exp[0].set(exp[0].const(0.0));
    exp[1].set(exp[1].const(1.0));
    exp[2].set(exp[2].const(2.0));
    exp[3].set(exp[3].const(4.0));
    exp[4].set(exp[4].const(5.0));
    exp[5].set(exp[5].const(6.0));
    exp[6].set(exp[6].const(8.0));
    exp[7].set(exp[7].const(9.0));
    exp[8].set(exp[8].const(10.0));
    ok := true;

    (;i: 9:
      win[i]?v;
      diff := v - exp[i];
      [ ~diff.negative() -> adiff := diff [] else -> adiff := negone * diff ];
      diff := eps - adiff;
      [ diff.negative() -> ok := false [] else -> skip ]
    );

    /* drain 3 remaining windows to avoid deadlock */
    (;_w: 9: win[_w]?v);
    (;_w: 9: win[_w]?v);
    (;_w: 9: win[_w]?v);

    pass!ok
  }
}

defproc TB_WindowAssembler (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) pix;
  chan(math::fixpoint<8,8>) win[9];
  WinAsmSrc<0>             src (.pix_in = pix);
  WindowAssembler<4, 4, 3> dut (.pix_in = pix, .win = win);
  WinAsmSink<0>            snk (.win    = win,  .pass = pass);
}


/* ================================================================
  3.  WinFork - K=2, fan-out to 3 filters

  Input window: [1, 2, 3, 4] (2x2).
  All three filter outputs must receive the identical values.
  ================================================================ */

template<pint DUMMY>
defproc WinForkSrc (chan!(math::fixpoint<8,8>) win_in[4])
{
  math::fixpoint<8,8> v[4];
  chp {
    (;k: 4: v[k].set(v[k].const((k+1)*1.0)));
    (;k: 4: win_in[k]!v[k])
  }
}

template<pint DUMMY>
defproc WinForkSink (chan?(math::fixpoint<8,8>) win_out[3][4]; chan!(bool) pass)
{
  math::fixpoint<8,8> v, exp[4], eps, negone, diff, adiff;
  bool ok;
  chp {
    eps.set(eps.const(0.02));
    negone.set(negone.const(-1.0));
    exp[0].set(exp[0].const(1.0));
    exp[1].set(exp[1].const(2.0));
    exp[2].set(exp[2].const(3.0));
    exp[3].set(exp[3].const(4.0));
    ok := true;
    (;f: 3:
      (;k: 4:
        win_out[f][k]?v;
        diff := v - exp[k];
        [ ~diff.negative() -> adiff := diff [] else -> adiff := negone * diff ];
        diff := eps - adiff;
        [ diff.negative() -> ok := false [] else -> skip ]
      )
    );
    pass!ok
  }
}

defproc TB_WinFork (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) win_in[4];
  chan(math::fixpoint<8,8>) win_out[3][4];
  WinForkSrc<0>  src (.win_in  = win_in);
  WinFork<3, 2>  dut (.win_in  = win_in, .win_out = win_out);
  WinForkSink<0> snk (.win_out = win_out, .pass = pass);
}


/* ================================================================
  4.  ConvBank - K=1, N_IN_CH=1, N_OUT=2

  W = [2.0, -1.0]  B = [0.0, 1.0]  input window = [3.0]
  Expected: out[0] = 2*3+0 = 6,  out[1] = -1*3+1 = -2
  ================================================================ */

template<pint DUMMY>
defproc ConvBankSrc (chan!(math::fixpoint<8,8>) win[2][1][1])
{
  math::fixpoint<8,8> v;
  chp {
    v.set(v.const(3.0));
    win[0][0][0]!v; win[1][0][0]!v
  }
}

template<pint DUMMY>
defproc ConvBankSink (chan?(math::fixpoint<8,8>) out[2]; chan!(bool) pass)
{
  math::fixpoint<8,8> v, exp[2], eps, negone, diff, adiff;
  bool ok;
  chp {
    eps.set(eps.const(0.02));
    negone.set(negone.const(-1.0));
    exp[0].set(exp[0].const(6.0));
    exp[1].set(exp[1].const(-2.0));
    ok := true;
    (;f: 2:
      out[f]?v;
      diff := v - exp[f];
      [ ~diff.negative() -> adiff := diff [] else -> adiff := negone * diff ];
      diff := eps - adiff;
      [ diff.negative() -> ok := false [] else -> skip ]
    );
    pass!ok
  }
}

defproc TB_ConvBank (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) win[2][1][1], w_ch[2], b_ch[2];
  chan(math::fixpoint<8,8>) out[2];
  ConvLayerParamSource<1, 1, 2,
                       {2.0, -1.0},
                       {0.0,  1.0}>      psrc (.w_out = w_ch, .b_out = b_ch);
  ConvBankSrc<0>                       src  (.win = win);
  ConvBank<1, 1, 2>                    dut  (.win = win, .w_in = w_ch,
                                             .b_in = b_ch, .out = out);
  ConvBankSink<0>                      snk  (.out = out, .pass = pass);
}


/* ================================================================
  5.  Flatten<N_CH=2, FEAT_H=1, FEAT_W=3>

  Same data as Flatten.
  Output layout: flat_out[(r*FEAT_W + c)*N_CH + ch]
    index 0: ch0,c0 = 1    index 1: ch1,c0 = 4
    index 2: ch0,c1 = 2    index 3: ch1,c1 = 5
    index 4: ch0,c2 = 3    index 5: ch1,c2 = 6

  Flatten reads (;r:(;c:(;ch:...))) - consume both channels
  per pixel - so drive both channels together per pixel.
  ================================================================ */

template<pint DUMMY>
defproc FlatSrc (chan!(math::fixpoint<8,8>) feat_in[2])
{
  math::fixpoint<8,8> v0[3], v1[3];
  chp {
    v0[0].set(v0[0].const(1.0)); v0[1].set(v0[1].const(2.0)); v0[2].set(v0[2].const(3.0));
    v1[0].set(v1[0].const(4.0)); v1[1].set(v1[1].const(5.0)); v1[2].set(v1[2].const(6.0));
    (;c: 3: feat_in[0]!v0[c]; feat_in[1]!v1[c])
  }
}

template<pint DUMMY>
defproc FlatSink (chan?(math::fixpoint<8,8>) flat_out[6]; chan!(bool) pass)
{
  math::fixpoint<8,8> v, exp[6], eps, negone, diff, adiff;
  bool ok;
  chp {
    eps.set(eps.const(0.02));
    negone.set(negone.const(-1.0));
    exp[0].set(exp[0].const(1.0)); exp[1].set(exp[1].const(4.0));
    exp[2].set(exp[2].const(2.0)); exp[3].set(exp[3].const(5.0));
    exp[4].set(exp[4].const(3.0)); exp[5].set(exp[5].const(6.0));
    ok := true;
    (;i: 6:
      flat_out[i]?v;
      diff := v - exp[i];
      [ ~diff.negative() -> adiff := diff [] else -> adiff := negone * diff ];
      diff := eps - adiff;
      [ diff.negative() -> ok := false [] else -> skip ]
    );
    pass!ok
  }
}

defproc TB_Flatten (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) feat[2], flat[6];
  FlatSrc<0>               src (.feat_in  = feat);
  Flatten<2, 1, 3, 0>  dut (.feat_in  = feat, .flat_out = flat);
  FlatSink<0>              snk (.flat_out = flat,  .pass = pass);
}


/* ================================================================
  6.  FCLayer - runtime weights, ReLU clamps -2 -> 0
  ================================================================ */

template<pint DUMMY>
defproc FCLayerSrc2 (chan!(math::fixpoint<8,8>) x[2])
{
  math::fixpoint<8,8> v0, v1;
  chp {
    v0.set(v0.const(1.0)); v1.set(v1.const(2.0));
    x[0]!v0; x[1]!v1
  }
}

template<pint DUMMY>
defproc FCLayerSink (chan?(math::fixpoint<8,8>) out[1]; chan!(bool) pass)
{
  math::fixpoint<8,8> v, zero, eps, negone, diff, adiff;
  bool ok;
  chp {
    eps.set(eps.const(0.02));
    negone.set(negone.const(-1.0));
    zero.set(zero.const(0.0));

    out[0]?v;
    diff := v - zero;
    [ ~diff.negative() -> adiff := diff [] else -> adiff := negone * diff ];
    diff := eps - adiff;
    ok := ~diff.negative();

    pass!ok
  }
}

defproc TB_FCLayer (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) x[2], y[1], w_ch[2], b_ch[1];
  FCLayerParamSource<2, 1,
                     {-1.0, -1.0},
                     {0.0}>              psrc (.w_out = w_ch, .b_out = b_ch);
  FCLayerSrc2<0>                            xsrc (.x    = x);
  FCLayer<2, 1, 2, 0, 0.0>       dut  (.x_in = x, .w_in = w_ch,
                                               .b_in = b_ch, .out = y);
  FCLayerSink<0>                            snk  (.out  = y, .pass = pass);
}


/* ================================================================
  7.  ConvLayer - runtime conv weights, ReLU zeros all
  ================================================================ */

template<pint DUMMY>
defproc ConvLayerSrc (chan!(math::fixpoint<8,8>) pixel_in[1])
{
  math::fixpoint<8,8> v[16];
  chp {
    (;i: 16: v[i].set(v[i].const(i * 1.0)));
    (;i: 16: pixel_in[0]!v[i])
  }
}

template<pint DUMMY>
defproc ConvLayerSink (chan?(math::fixpoint<8,8>) feat_out[1]; chan!(bool) pass)
{
  math::fixpoint<8,8> v, zero, eps, negone, diff, adiff;
  bool ok;
  chp {
    eps.set(eps.const(0.02));
    negone.set(negone.const(-1.0));
    zero.set(zero.const(0.0));
    ok := true;
    (;_i: 16:
      feat_out[0]?v;
      diff := v - zero;
      [ ~diff.negative() -> adiff := diff [] else -> adiff := negone * diff ];
      diff := eps - adiff;
      [ diff.negative() -> ok := false [] else -> skip ]
    );
    pass!ok
  }
}

defproc TB_ConvLayer (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) pix[1], feat[1], w_ch[1], b_ch[1];
  ConvLayerParamSource<1, 1, 1,
                       {1.0},
                       {-100.0}>         psrc (.w_out = w_ch, .b_out = b_ch);
  ConvLayerSrc<0>                        xsrc (.pixel_in = pix);
  ConvLayer<4, 4, 1, 1, 1, 2, 0, 0.0>
                                         dut  (.pixel_in = pix,
                                               .w_in = w_ch, .b_in = b_ch,
                                               .feat_out = feat);
  ConvLayerSink<0>                    snk  (.feat_out = feat, .pass = pass);
}


/* ================================================================
  8.  MaxPoolCh<P=3, FEAT_W=6, FEAT_H=6> - single channel

  Input: 6x6 image, pixels 0..35 in row-major order.
  P=3 stride-3 pooling produces a 2x2 output (4 values):

    window (rows 0-2, cols 0-2): {0,1,2,6,7,8,12,13,14}   -> max = 14
    window (rows 0-2, cols 3-5): {3,4,5,9,10,11,15,16,17} -> max = 17
    window (rows 3-5, cols 0-2): {18..20,24..26,30..32}   -> max = 32
    window (rows 3-5, cols 3-5): {21..23,27..29,33..35}   -> max = 35

  Note: MaxPoolCh iterates col over FEAT_W (outer) with stride P,
  and emits one max per pooling window in row-major order.
  ================================================================ */

template<pint DUMMY>
defproc MaxPoolChSrc (chan!(math::fixpoint<8,8>) in)
{
  math::fixpoint<8,8> v[36];
  chp {
    (;i: 36: v[i].set(v[i].const(i * 1.0)));
    (;i: 36: in!v[i])
  }
}

template<pint DUMMY>
defproc MaxPoolChSink (chan?(math::fixpoint<8,8>) out; chan!(bool) pass)
{
  math::fixpoint<8,8> v, exp[4], eps, negone, diff, adiff;
  bool ok;
  chp {
    eps.set(eps.const(0.02));
    negone.set(negone.const(-1.0));
    exp[0].set(exp[0].const(14.0));
    exp[1].set(exp[1].const(17.0));
    exp[2].set(exp[2].const(32.0));
    exp[3].set(exp[3].const(35.0));
    ok := true;
    (;i: 4:
      out?v;
      diff := v - exp[i];
      [ ~diff.negative() -> adiff := diff [] else -> adiff := negone * diff ];
      diff := eps - adiff;
      [ diff.negative() -> ok := false [] else -> skip ]
    );
    pass!ok
  }
}

defproc TB_MaxPoolCh (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) feat, pool;
  MaxPoolChSrc<0>        src (.in  = feat);
  MaxPoolCh<3, 6, 6>    dut (.in  = feat, .out = pool);
  MaxPoolChSink<0>       snk (.out = pool, .pass = pass);
}


/* ================================================================
  9.  MaxPool<N_CH=2, FEAT_W=6, FEAT_H=6, P=3> - two channels

  Channel 0: pixels 0..35 (same as above) -> pool outputs 14,17,32,35
  Channel 1: all pixels = 7.0             -> all pool outputs = 7.0

  MaxPool wraps MaxPoolCh per channel; both run concurrently.
  Source drives both channel streams in parallel because each MaxPoolCh
  reads a full row-group before producing output.
  ================================================================ */

template<pint DUMMY>
defproc MaxPoolSrc2Ch (chan!(math::fixpoint<8,8>) feat_in[2])
{
  math::fixpoint<8,8> v[36], seven;
  chp {
    seven.set(seven.const(7.0));
    (;i: 36: v[i].set(v[i].const(i * 1.0)));
    /* Each MaxPoolCh reads a full row-group before producing output,
       so both channels must be driven independently in parallel. */
    ( (;i: 36: feat_in[0]!v[i]) , (;i: 36: feat_in[1]!seven) )
  }
}

template<pint DUMMY>
defproc MaxPoolSink2Ch (chan?(math::fixpoint<8,8>) pool_out[2]; chan!(bool) pass)
{
  /* Collect all 4 outputs per channel in parallel, then check. */
  math::fixpoint<8,8> got0[4], got1[4];
  math::fixpoint<8,8> exp0[4], seven, eps, negone, diff, adiff;
  bool ok;
  chp {
    eps.set(eps.const(0.02));
    negone.set(negone.const(-1.0));
    seven.set(seven.const(7.0));
    exp0[0].set(exp0[0].const(14.0));
    exp0[1].set(exp0[1].const(17.0));
    exp0[2].set(exp0[2].const(32.0));
    exp0[3].set(exp0[3].const(35.0));
    ok := true;

    /* Receive all outputs from both channels in parallel */
    ( (;i: 4: pool_out[0]?got0[i]) , (;i: 4: pool_out[1]?got1[i]) );

    /* Check channel 0 */
    (;i: 4:
      diff := got0[i] - exp0[i];
      [ ~diff.negative() -> adiff := diff [] else -> adiff := negone * diff ];
      diff := eps - adiff;
      [ diff.negative() -> ok := false [] else -> skip ]
    );

    /* Check channel 1 - all must equal 7.0 */
    (;i: 4:
      diff := got1[i] - seven;
      [ ~diff.negative() -> adiff := diff [] else -> adiff := negone * diff ];
      diff := eps - adiff;
      [ diff.negative() -> ok := false [] else -> skip ]
    );

    pass!ok
  }
}

defproc TB_MaxPool (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) feat[2], pool[2];
  MaxPoolSrc2Ch<0>           src (.feat_in  = feat);
  MaxPool<2, 6, 6, 3, 0>     dut (.feat_in  = feat, .pool_out = pool);
  MaxPoolSink2Ch<0>          snk (.pool_out = pool, .pass = pass);
}

/* ================================================================
  10. End-to-end mini-CNN

  ConvLayer (K=1, 1ch, 4x4, ReLU, B=-6)
    -> MaxPool (4x4 -> 2x2, 1ch, P=2)
    -> Flatten (1ch, 2x2 -> 4 parallel outputs)
    -> FCLayer (4->1, step, W=0.25 each, B=-0.1)

  Only checks that one token arrives (no deadlock); exact value
  depends on floating-point rounding in the pool stage.
  ================================================================ */

template<pint DUMMY>
defproc E2ESrc (chan!(math::fixpoint<8,8>) pixel_in[1])
{
  math::fixpoint<8,8> v[16];
  chp {
    (;i: 16: v[i].set(v[i].const(i * 1.0)));
    (;i: 16: pixel_in[0]!v[i])
  }
}

template<pint DUMMY>
defproc E2ESink (chan?(math::fixpoint<8,8>) out[1]; chan!(bool) pass)
{
  math::fixpoint<8,8> v;
  chp {
    out[0]?v;
    pass!true    /* just verify no deadlock */
  }
}

defproc TB_E2E (chan!(bool) pass)
{
  chan(math::fixpoint<8,8>) pix[1], conv_out[1], pool_out[1], flat[4], fc_out[1];
  chan(math::fixpoint<8,8>) conv_w[1], conv_b[1], fc_w[4], fc_b[1];

  E2ESrc<0>                                    src    (.pixel_in = pix);
  ConvLayerParamSource<1, 1, 1,
                       {1.0},
                       {-6.0}>                  conv_p (.w_out = conv_w,
                                                        .b_out = conv_b);
  ConvLayer<4, 4, 1, 1, 1, 2, 0, 0.0>          conv   (.pixel_in = pix,
                                                        .w_in = conv_w,
                                                        .b_in = conv_b,
                                                        .feat_out = conv_out);
  MaxPool<1, 4, 4, 2, 0>                       pool   (.feat_in  = conv_out,
                                                        .pool_out = pool_out);
  Flatten<1, 2, 2, 0>                          flat_p (.feat_in  = pool_out,
                                                        .flat_out = flat);
  FCLayerParamSource<4, 1,
                     {0.25, 0.25, 0.25, 0.25},
                     {-0.1}>                    fc_p   (.w_out = fc_w,
                                                        .b_out = fc_b);
  FCLayer<4, 1, 1, 0, 0.0>                     fc     (.x_in = flat,
                                                        .w_in = fc_w,
                                                        .b_in = fc_b,
                                                        .out = fc_out);
  E2ESink<0>                                   snk    (.out  = fc_out, .pass = pass);
}


/* ================================================================
  Main - instantiate all testbenches and log results
  ================================================================ */

defproc Main ()
{
  chan(bool) p[13];

  TB_Act_Linear        t00 (.pass = p[0]);
  TB_Act_Step          t01 (.pass = p[1]);
  TB_Act_ReLU          t02 (.pass = p[2]);
  TB_Act_LeakyReLU     t03 (.pass = p[3]);
  TB_WindowAssembler   t04 (.pass = p[4]);
  TB_WinFork           t05 (.pass = p[5]);
  TB_ConvBank          t06 (.pass = p[6]);
  TB_Flatten           t07 (.pass = p[7]);
  TB_FCLayer           t08 (.pass = p[8]);
  TB_ConvLayer         t09 (.pass = p[9]);
  TB_MaxPoolCh         t10 (.pass = p[10]);
  TB_MaxPool           t11 (.pass = p[11]);
  TB_E2E               t12 (.pass = p[12]);

  bool r[13];

  chp {
    p[0]?r[0];   log("Activation/Linear      : ", r[0]);
    p[1]?r[1];   log("Activation/Step        : ", r[1]);
    p[2]?r[2];   log("Activation/ReLU        : ", r[2]);
    p[3]?r[3];   log("Activation/LeakyReLU   : ", r[3]);
    p[4]?r[4];   log("WindowAssembler        : ", r[4]);
    p[5]?r[5];   log("WinFork                : ", r[5]);
    p[6]?r[6];   log("ConvBank               : ", r[6]);
    p[7]?r[7];   log("Flatten                : ", r[7]);
    p[8]?r[8];   log("FCLayer                : ", r[8]);
    p[9]?r[9];   log("ConvLayer              : ", r[9]);
    p[10]?r[10]; log("MaxPoolCh              : ", r[10]);
    p[11]?r[11]; log("MaxPool                : ", r[11]);
    p[12]?r[12]; log("E2E mini-CNN           : ", r[12])
  }
}
